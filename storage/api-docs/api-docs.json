    "paths": {
        "/api/certificates/verify-name": {
            "post": {
                "tags": [
                    "Guest Learning & Checkout"
                ],
                "summary": "Verifikasi nama untuk klaim sertifikat kursus",
                "description": "Memverifikasi nama user sebelum mencetak sertifikat",
                "operationId": "verifyCertificateName",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "name_on_certificate"
                                ],
                                "properties": {
                                    "name_on_certificate": {
                                        "type": "string",
                                        "example": "Rafi Zaki"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Nama terverifikasi",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Verify certificate name"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/api/certificates/download/{code}": {
            "get": {
