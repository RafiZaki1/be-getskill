        "/api/checkout": {
            "post": {
                "tags": [
                    "Guest Learning & Checkout"
                ],
                "summary": "Checkout kursus (pilih metode pembayaran)",
                "description": "Membuat transaksi baru untuk pembelian kursus",
                "operationId": "checkoutCourse",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "course_id",
                                    "payment_method"
                                ],
                                "properties": {
                                    "course_id": {
                                        "type": "string",
                                        "example": "uuid-course"
                                    },
                                    "payment_method": {
                                        "type": "string",
                                        "example": "bank_transfer"
                                    },
                                    "bank_code": {
                                        "type": "string",
                                        "example": "BCA"
                                    },
                                    "voucher_code": {
                                        "type": "string",
                                        "example": "PROMO2026"
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Checkout berhasil dilakukan",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "properties": {
                                        "message": {
                                            "type": "string",
                                            "example": "Checkout course"
                                        }
                                    },
                                    "type": "object"
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
